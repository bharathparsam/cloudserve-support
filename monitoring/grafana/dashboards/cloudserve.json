  "links": [
    {
      "title": "App",
      "url": "http://localhost:8000",
      "type": "link",
      "targetBlank": true
    },
    {
      "title": "Targets",
      "url": "http://localhost:9090/targets",
      "type": "link",
      "targetBlank": true
    },
    {
      "title": "Alerts",
      "url": "http://localhost:9090/alerts",
      "type": "link",
      "targetBlank": true
    },
    {
      "title": "Rules",
      "url": "http://localhost:9090/rules",
      "type": "link",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "channel",
        "label": "Traffic channels",
        "type": "custom",
        "query": "email,chat,docs_comment,forum,invalid",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CloudServe / Operations",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No observations",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "## CloudServe support operations\nStored totals are historical. Recent rates need new processing across scrapes. Provider observations are not live health checks.\n\n[App](http://localhost:8000) \u00b7 [Prometheus targets](http://localhost:9090/targets) \u00b7 [Alerts](http://localhost:9090/alerts) \u00b7 Channel filter applies to traffic/outcomes only."
      }
