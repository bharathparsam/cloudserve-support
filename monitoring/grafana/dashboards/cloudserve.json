        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (channel,action) (rate(cloudserve_outcomes{job=\"cloudserve\",channel=~\"$channel\"}[$__rate_interval])) * 60",
          "refId": "A",
          "legendFormat": "{{channel}} \u00b7 {{action}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
