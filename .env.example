# Copying secrets into this template is forbidden. Keep real values in .env only.
# scripts/setup_secrets.py creates .env and generates both local passwords.
APP_MODE=live
FREE_ONLY=true

# Add your own OpenRouter API key locally.
OPENROUTER_API_KEY=

# Generated automatically by scripts/setup_secrets.py; never commit real values.
OPERATOR_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Initial model defaults. Saved operator settings take precedence after UI Save.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
DECIDER_MODEL=perplexity/pplx-decider-flash-v1.3:free
DECIDER_MODE=shadow
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

# setup_secrets.py replaces these with the current macOS/Linux user's UID/GID.
LOCAL_UID=10001
LOCAL_GID=10001
