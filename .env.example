# Run python -m scripts.setup_secrets, then edit only your local .env.
APP_MODE=live
FREE_ONLY=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

# setup_secrets generates these; never commit real values.
OPERATOR_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Optional paths; defaults are inside this project. The API, batch harness and
# metrics server must use the same storage/database to share outcomes and controls.
# STORAGE_PATH=./storage
# DATABASE_URL=sqlite:///./storage/decisions.db
