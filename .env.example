# Run python -m scripts.setup_secrets, then edit only your local .env.
APP_MODE=live
FREE_ONLY=true
OPENROUTER_API_KEY=
# MODEL_NAME takes precedence over the legacy OPENROUTER_MODEL alias.
# Saved operator settings take precedence over both; see README configuration.
MODEL_NAME=meta-llama/llama-3.1-8b-instruct:free
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

# setup_secrets generates these; never commit real values.
OPERATOR_TOKEN=
GRAFANA_ADMIN_PASSWORD=

# Run commands from this project directory when using relative paths.
# The API, batch harness and metrics server must share the same database.
# Optional base storage path (also set the explicit paths above when changing it):
# STORAGE_PATH=./storage
