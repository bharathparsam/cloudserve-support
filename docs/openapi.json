          "reason"
        ],
        "title": "ControlInput"
      },
      "DatasetLaunch": {
        "properties": {
          "dataset_id": {
            "type": "string",
            "const": "development",
            "title": "Dataset Id"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 500.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset_id"
        ],
        "title": "DatasetLaunch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OperatorSettings": {
        "properties": {
          "generation_model": {
            "type": "string",
            "maxLength": 200,
            "title": "Generation Model"
          },
          "decider_model": {
            "type": "string",
            "maxLength": 200,
            "title": "Decider Model"
          },
          "decider_mode": {
            "type": "string",
            "enum": [
              "disabled",
              "shadow",
              "enforce"
            ],
            "title": "Decider Mode"
          },
          "timeout_seconds": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 5.0,
            "title": "Timeout Seconds"
          },
          "max_retries": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Max Retries"
          },
          "generation_mode": {
            "type": "string",
            "enum": [
              "free_only",
              "paid_test"
            ],
            "title": "Generation Mode",
            "default": "free_only"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "generation_model",
          "decider_model",
          "decider_mode",
          "timeout_seconds",
          "max_retries"
        ],
        "title": "OperatorSettings"
      },
      "ReviewInput": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "in_review",
              "reviewed"
            ],
            "title": "Status"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "title": "Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ReviewInput"
      },
      "TicketInput": {
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "email",
              "chat",
              "docs_comment",
              "forum"
            ],
            "title": "Channel"
          },
          "body": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Body"
          },
          "subject": {
            "type": "string",
            "maxLength": 1000,
            "title": "Subject",
            "default": ""
          },
          "ticket_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ticket Id"
          },
          "received_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Received At"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Id"
          },
          "customer_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Name"
          }
        },
        "type": "object",
        "required": [
          "channel",
          "body"
        ],
        "title": "TicketInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
